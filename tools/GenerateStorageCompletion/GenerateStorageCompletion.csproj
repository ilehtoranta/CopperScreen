<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType><ImplicitUsings>enable</ImplicitUsings>
    <CopperSharp68kRoot Condition="'$(CopperSharp68kRoot)' == ''">$(MSBuildThisFileDirectory)../../../CopperSharp68k</CopperSharp68kRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Guest/**/*.cs" />
    <ProjectReference Include="Guest/StorageCompletion.Guest.csproj" />
    <ProjectReference Include="$(CopperSharp68kRoot)/Compiler/CopperSharp.Compiler.csproj" />
    <ProjectReference Include="$(CopperSharp68kRoot)/Targets.Amiga/CopperSharp.Targets.Amiga.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>CopperScreen</PackageId>
    <Version>1.2.1</Version>
    <AssemblyVersion>1.2.1.0</AssemblyVersion>
    <FileVersion>1.2.1.0</FileVersion>
    <InformationalVersion>1.2.1</InformationalVersion>
    <Title>CopperScreen</Title>
    <Authors>CopperMod contributors</Authors>
    <Description>Native Amiga 500 PAL emulator front-end backed by CopperMod.Amiga.Lightweight.</Description>
    <ApplicationIcon>Assets\CopperScreen.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- The PCM producer must meet deadlines from its first guest fields.
         Compile app methods optimized immediately instead of running slow Tier 0
         until promotion; framework ReadyToRun code can still use tiering. -->
    <TieredCompilationQuickJit>false</TieredCompilationQuickJit>
    <Copper68kBoundaryVersion Condition="'$(Copper68kBoundaryVersion)' == ''">1.5.11</Copper68kBoundaryVersion>
    <CopperScreenEnableCopperStart Condition="'$(CopperScreenEnableCopperStart)' == ''">false</CopperScreenEnableCopperStart>
    <DefineConstants Condition="'$(CopperScreenEnableCopperStart)' == 'true'">$(DefineConstants);COPPERSCREEN_ENABLE_COPPERSTART</DefineConstants>
    <CopperOsBundleDirectory Condition="'$(CopperOsBundleDirectory)' == ''">$(MSBuildProjectDirectory)/../artifacts/copperos-bundle</CopperOsBundleDirectory>
    <CopperStartMiniBundleDirectory Condition="'$(CopperStartMiniBundleDirectory)' == ''">$(MSBuildProjectDirectory)/../artifacts/copperstart-mini-bundle</CopperStartMiniBundleDirectory>
    <CopperScreenIncludeMiniRom Condition="'$(CopperScreenIncludeMiniRom)' == '' And Exists('$(CopperStartMiniBundleDirectory)/CopperStart-Mini.rom')">true</CopperScreenIncludeMiniRom>
    <CopperScreenIncludeMiniRom Condition="'$(CopperScreenIncludeMiniRom)' == ''">false</CopperScreenIncludeMiniRom>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CopperScreenInstalledTests)' == 'true'">
    <DefineConstants>$(DefineConstants);COPPERSCREEN_INSTALLED_TESTS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;NU1900</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="CopperPad" Version="2.0.0-preview.2" />
    <PackageReference Include="CopperPad.HidSharp" Version="2.0.0-preview.2" />
    <PackageReference Include="HotPathGuard.Abstractions" Version="0.1.0" />
    <PackageReference Include="HotPathGuard.Analyzers" Version="0.1.0" PrivateAssets="all" />
    <PackageReference Include="Hst.Compression" Version="1.0.104" />
    <PackageReference Include="Miniaudio-CS" Version="1.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CopperMod.Amiga.Lightweight\CopperMod.Amiga.Lightweight.csproj" />
    <PackageReference Include="Copper68k" Version="[$(Copper68kBoundaryVersion)]" />
    <PackageReference Include="CopperStart.FileSystem.Service" Version="[0.5.0-dev.7]" />
    <ProjectReference Include="..\CopperDisk\CopperDisk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CopperScreen.FileSystems/CopperScreen.FileSystems.csproj" />
    <ProjectReference Include="../CopperDisk.FileSystem/CopperDisk.FileSystem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Presets\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Firmware/CopperStart-LICENSE.txt" Link="CopperStart-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Condition="'$(CopperScreenIncludeMiniRom)' == 'true'" Include="Firmware/CopperStartMini.sha256" LogicalName="CopperScreen.Firmware.CopperStartMini.sha256" />
    <None Condition="'$(CopperScreenIncludeMiniRom)' == 'true'" Include="$(CopperStartMiniBundleDirectory)/CopperStart-Mini.rom" Link="ROM/CopperStart-Mini.rom" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Condition="'$(CopperScreenIncludeMiniRom)' == 'true'" Include="$(CopperStartMiniBundleDirectory)/LICENSE.txt" Link="ROM/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Firmware\CopperStartA1200.json" LogicalName="CopperScreen.Firmware.CopperStartA1200.json" />
    <EmbeddedResource Include="Firmware\CopperStart.json" />
    <EmbeddedResource Include="Firmware\CopperOS.json" />
    <EmbeddedResource Include="Firmware\CopperOsA1200.json" LogicalName="CopperScreen.Firmware.CopperOsA1200.json" />
    <EmbeddedResource Condition="'$(CopperScreenEnableCopperStart)' == 'true'" Include="$(CopperOsBundleDirectory)/CopperStart-A1200.rom" LogicalName="CopperScreen.Bundled.CopperStart-A1200.rom" />
    <EmbeddedResource Condition="'$(CopperScreenEnableCopperStart)' == 'true'" Include="$(CopperOsBundleDirectory)/CopperOS.hdf" LogicalName="CopperScreen.Bundled.CopperOS.hdf" />
    <Compile Remove="Diagnostics\CopperOsNativeStorageProof.cs" Condition="'$(CopperScreenInstalledTests)' != 'true'" />
    <AvaloniaResource Include="Assets\CopperScreen.ico" />
  </ItemGroup>

  <Target Name="RequireCopperOsBundle" BeforeTargets="PrepareForBuild" Condition="'$(CopperScreenEnableCopperStart)' == 'true'">
    <Error Condition="!Exists('$(CopperOsBundleDirectory)/CopperStart-A1200.rom') Or !Exists('$(CopperOsBundleDirectory)/CopperOS.hdf')"
           Text="Stage the qualified CopperOS bundle using scripts/prepare-copperos-bundle.ps1 -CopperStartA1200Rom &lt;rom&gt; -CopperOsHdf &lt;hdf&gt;, or set CopperOsBundleDirectory to the staged directory." />
    <ItemGroup>
      <_CopperOsBundleInput Include="$(CopperOsBundleDirectory)/CopperStart-A1200.rom" ExpectedHash="269C41EE42F89859769BE7F171F7D18C0528BB5C1C38EFBE25ECF1F16A380962" />
      <_CopperOsBundleInput Include="$(CopperOsBundleDirectory)/CopperOS.hdf" ExpectedHash="DC597FA79C5479D43E98ABDEDFCB885056F9C22AFFA161126FF1B27C39C3CFA7" />
    </ItemGroup>
    <GetFileHash Files="@(_CopperOsBundleInput)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_CopperOsBundleHash" />
    </GetFileHash>
    <Error Condition="'%(_CopperOsBundleHash.FileHash)' != '%(_CopperOsBundleHash.ExpectedHash)'" Text="Unqualified CopperOS bundle input: %(_CopperOsBundleHash.Identity). Run scripts/prepare-copperos-bundle.ps1 with the qualified files." />
  </Target>

  <Target Name="VerifyCopperStartMiniBundle" BeforeTargets="PrepareForBuild" Condition="'$(CopperScreenIncludeMiniRom)' == 'true'">
    <Error Condition="!Exists('$(CopperStartMiniBundleDirectory)/CopperStart-Mini.rom') Or !Exists('$(CopperStartMiniBundleDirectory)/LICENSE.txt')"
           Text="Stage the qualified Mini ROM and license with scripts/prepare-copperstart-mini-bundle.ps1." />
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)/Firmware/CopperStartMini.sha256">
      <Output TaskParameter="Lines" ItemName="_CopperStartMiniExpectedHash" />
    </ReadLinesFromFile>
    <GetFileHash Files="$(CopperStartMiniBundleDirectory)/CopperStart-Mini.rom" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_CopperStartMiniHash" />
    </GetFileHash>
    <Error Condition="'%(_CopperStartMiniHash.FileHash)' != '@(_CopperStartMiniExpectedHash)'"
           Text="CopperStart Mini does not match the qualified ROM hash in Firmware/CopperStartMini.sha256." />
  </Target>

  <ItemGroup>
    <Compile Remove="artifacts\**\*.cs" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>CopperDisk</PackageId>
    <Title>CopperDisk</Title>
    <Authors>Ilkka Lehtoranta</Authors>
    <Description>Managed Amiga ADF, extended ADF, ADZ, DMS, IPF, and SCP disk image library.</Description>
    <PackageVersion>3.0.0</PackageVersion>
    <Version>$(PackageVersion)</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://ilehtoranta.github.io/CopperScreen/copperdisk.html</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ilehtoranta/CopperScreen.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>amiga;emulation;adf;adz;dms;ipf;scp;flux;disk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>copperdisk-icon.png</PackageIcon>
    <PackageReleaseNotes>Stable 3.0.0: managed IPF decoding with density selectors, per-cell timing weights, stored gap streams and weak/no-flux regions; read-only SCP decoding; aggregate loader options; hardfile configuration and partition metadata. Compared with stable 2.1.0, AmigaEncodedTrack.WrapBitOffset is internal and custom IWritableAmigaSectorDiskMedia implementations must provide TryWriteBytes. Standard ADF synthetic revolutions remain 6334 MFM words.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;NU1900</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="copperdisk-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

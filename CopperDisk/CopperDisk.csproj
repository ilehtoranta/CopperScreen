<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>CopperDisk</PackageId>
    <Title>CopperDisk</Title>
    <Authors>Ilkka Lehtoranta</Authors>
    <Description>Managed Amiga ADF, extended ADF, ADZ, DMS, IPF, and SCP disk image library.</Description>
    <PackageVersion>3.0.1-dev.1</PackageVersion>
    <Version>$(PackageVersion)</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://ilehtoranta.github.io/CopperScreen/copperdisk.html</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ilehtoranta/CopperScreen.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>amiga;emulation;adf;adz;dms;ipf;scp;flux;disk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>copperdisk-icon.png</PackageIcon>
    <PackageReleaseNotes>Development source: read-only UAE-1ADF and encoded-track media support up to 84 DD cylinders, preserving additional raw tracks and decoding normal tracks beyond cylinder 79. Zero-bit raw entries expose a zero-filled PAL DD revolution. Not a published release. Standard ADF synthetic revolutions remain 6334 MFM words.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;NU1900</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="copperdisk-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

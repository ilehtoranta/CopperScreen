<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Isolated cache; unreleased CPU fixes use the explicitly pinned local feed. -->
    <add key="globalPackagesFolder" value="artifacts/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="copper-development" value="artifacts/development-packages" />
  </packageSources>
</configuration>

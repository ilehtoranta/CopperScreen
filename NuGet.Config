<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Keep local experimental packages out of the published dependency boundary. -->
    <add key="globalPackagesFolder" value="artifacts/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>CopperScreen</PackageId>
    <Version>1.1.3</Version>
    <AssemblyVersion>1.1.3.0</AssemblyVersion>
    <FileVersion>1.1.3.0</FileVersion>
    <InformationalVersion>1.1.3</InformationalVersion>
    <Title>CopperScreen</Title>
    <Authors>CopperMod contributors</Authors>
    <Description>Native Amiga 500 PAL emulator front-end backed by CopperMod.Amiga.Lightweight.</Description>
    <ApplicationIcon>Assets\CopperScreen.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- The PCM producer must meet deadlines from its first guest fields.
         Compile app methods optimized immediately instead of running slow Tier 0
         until promotion; framework ReadyToRun code can still use tiering. -->
    <TieredCompilationQuickJit>false</TieredCompilationQuickJit>
    <Copper68kBoundaryVersion Condition="'$(Copper68kBoundaryVersion)' == ''">1.5.4-qualified-dev.1</Copper68kBoundaryVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CopperScreenInstalledTests)' == 'true'">
    <DefineConstants>$(DefineConstants);COPPERSCREEN_INSTALLED_TESTS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;NU1900</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="CopperPad" Version="2.0.0-preview.1" />
    <PackageReference Include="CopperPad.HidSharp" Version="2.0.0-preview.1" />
    <PackageReference Include="HotPathGuard.Abstractions" Version="0.1.0" />
    <PackageReference Include="HotPathGuard.Analyzers" Version="0.1.0" PrivateAssets="all" />
    <PackageReference Include="Miniaudio-CS" Version="1.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CopperMod.Amiga.Lightweight\CopperMod.Amiga.Lightweight.csproj" />
    <PackageReference Include="Copper68k" Version="[$(Copper68kBoundaryVersion)]" />
    <ProjectReference Include="..\CopperDisk\CopperDisk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Presets\*.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Firmware\MinimalDiskBoot.s" />
    <EmbeddedResource Include="Firmware\CopperStart.json" />
    <EmbeddedResource Include="Firmware\CopperOS.json" />
    <Compile Remove="Diagnostics\CopperOsNativeStorageProof.cs" Condition="'$(CopperScreenInstalledTests)' != 'true'" />
    <AvaloniaResource Include="Assets\CopperScreen.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**\*.cs" />
  </ItemGroup>

</Project>

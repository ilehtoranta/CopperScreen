<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DefineConstants>$(DefineConstants);COPPERSCREEN_INSTALLED_MEDIA_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Workloads/corpus-lotus2.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
    <Compile Include="../CopperScreen/Diagnostics/CopperOsNativeStorageProof.cs" Link="Diagnostics/CopperOsNativeStorageProof.cs" />
    <Compile Include="../CopperScreen/Diagnostics/CopperScreenInstalledMediaProof.cs" Link="Diagnostics/CopperScreenInstalledMediaProof.cs" />
    <Compile Include="../CopperScreen/Diagnostics/CopperScreenRdbImageProof.cs" Link="Diagnostics/CopperScreenRdbImageProof.cs" />
    <ProjectReference Include="..\CopperScreen\CopperScreen.csproj" />
    <ProjectReference Include="../CopperScreen.Storage.Probe/CopperScreen.Storage.Probe.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="../CopperMod.Amiga.Lightweight.Tests/IpfFixture.cs" Link="Fixtures/IpfFixture.cs" />
    <Compile Include="../CopperMod.Amiga.Lightweight.Tests/DiskFormatFixture.cs" Link="Fixtures/DiskFormatFixture.cs" />
  </ItemGroup>
  <Target Name="CopyStorageInterruptionProbe" AfterTargets="Build">
    <MSBuild Projects="../CopperScreen.Storage.Probe/CopperScreen.Storage.Probe.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="StorageProbeTarget" />
    </MSBuild>
    <ItemGroup>
      <StorageProbeFiles Include="@(StorageProbeTarget)" />
      <StorageProbeFiles Include="@(StorageProbeTarget->'%(RootDir)%(Directory)%(Filename).runtimeconfig.json')" />
      <StorageProbeFiles Include="@(StorageProbeTarget->'%(RootDir)%(Directory)%(Filename).deps.json')" />
    </ItemGroup>
    <!-- Dependencies are the same pinned engine/disk libraries already in the test output. -->
    <Copy SourceFiles="@(StorageProbeFiles)" DestinationFolder="$(TargetDir)" />
  </Target>
</Project>

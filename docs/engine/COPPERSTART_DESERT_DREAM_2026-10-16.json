  "compatibilityFixes": [
    {
      "id": "CS-COMPAT-006",
      "subsystem": "BootstrapCore ExecBase physical extended-memory limit",
      "cause": "The allocator knows the A501 bank, but ExecBase.MaxExtMem at $4E remains zero. The loader subtracts $80000 from MaxExtMem and uses MaxLocMem-$80000 as its fallback. With 512 KiB Chip RAM the fallback is zero, so it displays the hardware requirement message.",
      "fix": "Publish the highest detected non-Chip memory end in MaxExtMem when adding physical banks, then calculate the ExecBase checksum after memory discovery. No game recognition, media modifications or host traps.",
      "nativeControl": "An original generated boot block reads MaxLocMem=$80000 and MaxExtMem=$C80000 under native Kickstart 1.3. The preceding CopperStart ROM reads $80000/$0; the fresh ROM reads $80000/$C80000."
    },
    {
      "id": "CS-COMPAT-007",
      "subsystem": "BootstrapCore static ExecBase checksum",
      "cause": "The independent probe also observes a checksum sum of $FFFF under native Kickstart but zero under CopperStart. The former implementation stores the two's-complement sum.",
      "fix": "Store the one's-complement sum after memory discovery and validate a low-word sum of $FFFF. Both portable and native-loader tests assert this convention.",
      "scope": "The memory-limit-only image already clears the demo's hardware check. This separate ABI correction is included in the final qualified source image."
    }
  ],

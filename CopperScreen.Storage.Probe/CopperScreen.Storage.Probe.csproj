    <DefineConstants>$(DefineConstants);COPPERSCREEN_STORAGE_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CopperMod.Amiga.Lightweight/CopperMod.Amiga.Lightweight.csproj" />
    <Compile Include="../CopperScreen/CopperScreenAtomicFile.cs" Link="CopperScreenAtomicFile.cs" />
    <Compile Include="../CopperScreen/CopperOsWorkspace.cs" Link="CopperOsWorkspace.cs" />
    <Compile Include="../CopperScreen/CopperOsWorkspace.Recovery.cs" Link="CopperOsWorkspace.Recovery.cs" />
    <Compile Include="../CopperScreen/CopperScreenUserData.cs" Link="CopperScreenUserData.cs" />
    <EmbeddedResource Include="../CopperScreen/Firmware/CopperOS.json" LogicalName="CopperScreen.Firmware.CopperOS.json" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <DefineConstants Condition="'$(LightweightReferencePath)' == ''">$(DefineConstants);LIGHTWEIGHT_CD32</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(LightweightReferencePath)' == ''">
    <ProjectReference Include="..\CopperMod.Amiga.Lightweight\CopperMod.Amiga.Lightweight.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(LightweightReferencePath)' != ''">
    <Reference Include="CopperMod.Amiga.Lightweight" HintPath="$(LightweightReferencePath)" Private="true" />
    <Reference Include="CopperDisk" HintPath="$([System.IO.Path]::GetDirectoryName('$(LightweightReferencePath)'))/CopperDisk.dll" Private="true" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Copper68k" Version="[$(Copper68kBoundaryVersion)]" />
  </ItemGroup>
</Project>

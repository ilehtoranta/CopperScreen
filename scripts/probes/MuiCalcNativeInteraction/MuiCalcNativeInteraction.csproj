      <HintPath>../../../CopperMod.Amiga.Lightweight.Runner/bin/Release/net10.0/CopperMod.Amiga.Lightweight.dll</HintPath>
    </Reference>
    <Reference Include="Copper68k">
      <HintPath>../../../CopperMod.Amiga.Lightweight.Runner/bin/Release/net10.0/Copper68k.dll</HintPath>
    </Reference>
    <Reference Include="CopperDisk">
      <HintPath>../../../CopperMod.Amiga.Lightweight.Runner/bin/Release/net10.0/CopperDisk.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>

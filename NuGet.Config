<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Keep package restore isolated from the machine-wide cache. -->
    <add key="globalPackagesFolder" value="artifacts/packages" />
  </config>
  <packageSources>
    <clear />
    <!-- Unpublished Detroit CPU development packages built from CopperMod. -->
    <add key="detroit-development" value="artifacts/detroit-fix-2026-10-08/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

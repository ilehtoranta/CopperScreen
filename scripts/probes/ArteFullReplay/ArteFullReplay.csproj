<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Reuse the existing host-test friend boundary, outside production execution. -->
    <AssemblyName>CopperScreen.Lightweight.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../CopperScreen/CopperScreen.csproj" />
    <Compile Include="../../../CopperScreen.Lightweight.Tests/NativeCapture.cs" Link="NativeCapture.cs" />
  </ItemGroup>
</Project>

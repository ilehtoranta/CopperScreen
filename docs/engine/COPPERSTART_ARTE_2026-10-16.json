  "compatibilityFixes": [
    {
      "id": "CS-COMPAT-002",
      "subsystem": "NativeTrackDiskDevice.Open",
      "cause": "Arte builds its own request at $200 without setting mn_Length. The length gate rejects OpenDevice and clears io_Device/io_Unit.",
      "fix": "Open unit zero without requiring an allocation-length receipt on the caller-built request.",
      "control": "An original generated loader with mn_Length zero opens and reads 512 bytes under native Kickstart 1.3; the pre-fix ROM returns -1 with no transfer."
    },
    {
      "id": "CS-COMPAT-003",
      "subsystem": "BootstrapCore memory discovery",
      "cause": "The fitted 512 KiB A501 bank is absent from Exec memory headers because it is outside the Autoconfig chain.",
      "fix": "Probe independent words at $C00000/$C40000/$C7FFFC, restore their values and register the fitted bank as Public/Fast pseudo-fast memory. Set its bootstrap status flag. Absent and 256 KiB aliased probe controls do not register a 512 KiB bank."
    },
    {
      "id": "CS-COMPAT-004",
      "subsystem": "NativeTrackDiskDevice installation defaults",
      "cause": "The reader restores reset DDRB=0 and ADKCON=0. Arte expects disk output pins and fast MFM mode to have been initialized by the ROM; drive selection and raw disk DMA consequently stall.",
      "fix": "Initialize CIA B disk output directions and ADKCON disk mode bits during device installation. Keep transaction cleanup restoring the inherited hardware state."
    },
    {
      "id": "CS-COMPAT-005",
      "subsystem": "BootstrapCore Chip RAM MemHeader",
      "cause": "The bootstrap stack reservation splits Chip RAM into two public headers; the first ends at $58000. Arte reads the bank extent and displays SOS $41, no memory, $781E0 bytes wanted.",
      "fix": "Publish one physical Chip RAM bank, with mh_Upper=$80000 for the tested A500. Reserve the live stack/private arena through AllocAbs so normal allocations still exclude those areas."
    }
  ],
